includes:
    - ../../../src/laravel-dependency-access.neon
parameters:
    level: 0
    paths: [Calls.php]
    tmpDir: ../../../build/phpstan-dependency-access
    noldors:
        laravel:
            useCases:
                classes: [DependencyAccess\UseCase]
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            useCaseTransportTypes: [Symfony\Component\HttpFoundation\Request]
            globalActorMethods: [user, id]
            dependencyInjection:
                classes: []
                namespaces: [DependencyAccess]
                excludedClasses: [Illuminate\Database\Eloquent\Model, Illuminate\Database\Migrations\Migration, Illuminate\Support\ServiceProvider, PHPUnit\Framework\TestCase, Illuminate\Support\Facades\Facade, DependencyAccess\UseCase]
                excludedNamespaces: []
                excludedPaths: []
                helpers: []
                allLaravelHelpers: false
                serviceLocatorTypes: [Illuminate\Contracts\Container\Container, Illuminate\Container\Container, Psr\Container\ContainerInterface]
                serviceLocatorMethods: [make, makeWith, get, offsetGet, getInstance, call, build, factory]
services:
    noldors.laravel.useCases:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.laravel.useCases.classes%
        autowired: false
parametersSchema:
    noldors: structure([
        laravel: structure([
            useCases: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            useCaseTransportTypes: listOf(string()),
            globalActorMethods: listOf(string()),
            dependencyInjection: structure([
                classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string()),
                excludedPaths: listOf(string()), helpers: listOf(string()), allLaravelHelpers: bool(), serviceLocatorTypes: listOf(string()), serviceLocatorMethods: listOf(string())
            ])
        ])
    ])
