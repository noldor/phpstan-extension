includes:
    - php-dependencies.neon

parameters:
    noldors:
        disabledTlsVerification:
            excludePaths: []
            laravelClients: false
        fullRequestLogging:
            loggerClasses: [Psr\Log\LoggerInterface]
            requestClasses: [Symfony\Component\HttpFoundation\Request, Psr\Http\Message\ServerRequestInterface]
            requestMethods:
                - {class: Symfony\Component\HttpFoundation\Request, methods: [getContent, toArray, getPayload]}
                - {class: Psr\Http\Message\ServerRequestInterface, methods: [getParsedBody, getBody]}
            excludePaths: []
        assertions:
            forbiddenMethods:
                - {class: PDO, methods: [exec]}
                - {class: PDOStatement, methods: [execute]}
            forbiddenFunctions: [file_put_contents, fwrite, unlink, mkdir, rmdir, rename, copy, mail, exec, shell_exec, system, passthru]
        phpunitDataProviders:
            forbiddenMethods:
                - {class: PDO, methods: ['*']}
                - {class: PDOStatement, methods: ['*']}
                - {class: Psr\Http\Client\ClientInterface, methods: [sendRequest]}
                - {class: Psr\SimpleCache\CacheInterface, methods: ['*']}
                - {class: PHPUnit\Framework\TestCase, methods: [createMock, createConfiguredMock, createPartialMock, getMockBuilder, createStub, createConfiguredStub, getStubBuilder, createMockForIntersectionOfInterfaces, createStubForIntersectionOfInterfaces]}
                - {class: PHPUnit\Framework\MockObject\MockBuilder, methods: [getMock]}
                - {class: PHPUnit\Framework\MockObject\TestStubBuilder, methods: [getStub]}
                - {class: Mockery, methods: [mock, spy]}
            forbiddenFunctions: [file_get_contents, file_put_contents, fopen, fread, fwrite, unlink, mkdir, rmdir, rename, copy, curl_exec, curl_multi_exec, exec, shell_exec, system, passthru, mail]
        databaseBuilderMocks:
            classes: []
            namespaces: []
            excludedClasses: []
            excludedNamespaces: []
            forbiddenTypes: [Illuminate\Database\Eloquent\Builder, Illuminate\Database\Query\Builder, Illuminate\Database\Eloquent\Relations\Relation]
        dependencies:
            classes: []
            namespaces: []
            excludedClasses: []
            excludedNamespaces: []
        foreignKeys:
            paths: []
            excludePaths: []
        laravel:
            enums:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            enumDirectories: []
            lighthouseValidators:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            lighthouseResolvers:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            lighthouseSubscriptions:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            useCaseTransportTypes:
                - Symfony\Component\HttpFoundation\Request
                - GraphQL\Type\Definition\ResolveInfo
                - Nuwave\Lighthouse\Execution\ResolveInfo
                - Nuwave\Lighthouse\Execution\Arguments\ArgumentSet
                - Nuwave\Lighthouse\Execution\Arguments\Argument
            globalActorMethods: [user, id]
            dependencyInjection:
                classes: []
                namespaces: []
                excludedClasses:
                    - Illuminate\Database\Eloquent\Model
                    - Illuminate\Database\Migrations\Migration
                    - Illuminate\Support\ServiceProvider
                    - PHPUnit\Framework\TestCase
                excludedNamespaces: []
                excludedPaths: [tests, database/migrations]
                helpers: []
                allLaravelHelpers: false
                serviceLocatorTypes:
                    - Illuminate\Contracts\Container\Container
                    - Illuminate\Container\Container
                    - Psr\Container\ContainerInterface
                serviceLocatorMethods: [make, makeWith, get, offsetGet, getInstance, call, build, factory]
            validationContracts:
                relationships: []
                inputValidators: []
            useCases:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            events:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            jobs:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            listeners:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            notifications:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            observers:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            validators:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            softDeleteModels:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            bulkLifecycleOperations:
                classes: []
                namespaces: []
                excludedClasses: []
                excludedNamespaces: []
            completedEventSuffixes: [Created, Updated, Deleted, Restored, Saved, ForceDeleted, Trashed]
            validationExceptions: [Illuminate\Validation\ValidationException]
            errorBagClasses: [Illuminate\Support\MessageBag, Illuminate\Support\ViewErrorBag]
            softDeleteTraits: [Illuminate\Database\Eloquent\SoftDeletes]
            validationSideEffects:
                forbiddenMethods:
                    - {class: Illuminate\Database\Eloquent\Model, methods: [save, saveOrFail, saveQuietly, update, updateOrFail, updateQuietly, delete, deleteOrFail, deleteQuietly, destroy, forceDelete, forceDeleteQuietly, forceDestroy, restore, restoreQuietly, push, pushQuietly, increment, decrement, touch, touchQuietly]}
                    - {class: Illuminate\Database\Eloquent\Builder, methods: [create, createQuietly, forceCreate, forceCreateQuietly, firstOrCreate, createOrFirst, updateOrCreate, upsert, update, delete, forceDelete, restore, increment, decrement, touch]}
                    - {class: Illuminate\Database\Query\Builder, methods: [insert, insertGetId, insertOrIgnore, insertUsing, insertOrIgnoreUsing, update, updateOrInsert, upsert, delete, truncate, increment, decrement, incrementEach, decrementEach]}
                    - {class: Illuminate\Database\Eloquent\Relations\Relation, methods: [save, saveMany, create, createMany, touch]}
                    - {class: Illuminate\Database\Eloquent\Relations\BelongsToMany, methods: [attach, detach, sync, syncWithoutDetaching, syncWithPivotValues, toggle, updateExistingPivot]}
                    - {class: Illuminate\Database\ConnectionInterface, methods: [insert, update, delete, statement, unprepared, affectingStatement]}
                    - {class: Illuminate\Contracts\Bus\Dispatcher, methods: [dispatch, dispatchSync, dispatchNow, dispatchToQueue]}
                    - {class: Illuminate\Contracts\Events\Dispatcher, methods: [dispatch, until, push, flush]}
                    - {class: Illuminate\Contracts\Queue\Queue, methods: [push, pushOn, later, laterOn, bulk]}
                    - {class: Illuminate\Contracts\Notifications\Dispatcher, methods: [send, sendNow]}
                    - {class: Illuminate\Contracts\Mail\Mailer, methods: [raw, send, sendNow]}
                    - {class: Illuminate\Contracts\Mail\MailQueue, methods: [queue, later]}
                    - {class: Illuminate\Contracts\Mail\Mailable, methods: [send, queue, later]}
                    - {class: Illuminate\Mail\Mailer, methods: [html, raw, send, sendNow, queue, queueOn, later, laterOn]}
                    - {class: Illuminate\Mail\PendingMail, methods: [send, sendNow, queue, later]}
                    - {class: Illuminate\Notifications\RoutesNotifications, methods: [notify, notifyNow]}
                    - {class: Illuminate\Foundation\Bus\Dispatchable, methods: [dispatch, dispatchIf, dispatchUnless, dispatchSync, dispatchAfterResponse]}
                    - {class: Illuminate\Foundation\Events\Dispatchable, methods: [dispatch, dispatchIf, dispatchUnless, broadcast]}
                    - {class: Illuminate\Http\Client\PendingRequest, methods: [send, get, head, post, put, patch, delete, options, pool, batch]}
                    - {class: Illuminate\Http\Client\Factory, methods: [send, get, head, post, put, patch, delete, options, pool, batch]}
                    - {class: Illuminate\Contracts\Filesystem\Filesystem, methods: [put, writeStream, delete, deleteDirectory, makeDirectory, copy, move, setVisibility]}
                    - {class: Illuminate\Contracts\Cache\Repository, methods: [put, putMany, add, forever, increment, decrement, forget, flush, remember, rememberForever]}
                    - {class: PDO, methods: [exec]}
                    - {class: Illuminate\Support\Facades\DB, methods: [insert, update, delete, statement, unprepared, affectingStatement]}
                    - {class: Illuminate\Support\Facades\Bus, methods: [dispatch, dispatchSync, dispatchNow, dispatchToQueue]}
                    - {class: Illuminate\Support\Facades\Event, methods: [dispatch, until, push, flush]}
                    - {class: Illuminate\Support\Facades\Queue, methods: [push, pushOn, later, laterOn, bulk]}
                    - {class: Illuminate\Support\Facades\Notification, methods: [send, sendNow]}
                    - {class: Illuminate\Support\Facades\Mail, methods: [html, raw, send, sendNow, queue, queueOn, later, laterOn]}
                    - {class: Illuminate\Support\Facades\Http, methods: [send, get, head, post, put, patch, delete, options, pool, batch]}
                    - {class: Illuminate\Support\Facades\Storage, methods: [put, writeStream, delete, deleteDirectory, makeDirectory, copy, move, setVisibility]}
                    - {class: Illuminate\Support\Facades\Cache, methods: [put, putMany, add, forever, increment, decrement, forget, flush, remember, rememberForever]}
                forbiddenFunctions: [dispatch, dispatch_sync, event, file_put_contents, unlink, mkdir, rmdir, rename, copy, mail, curl_exec, curl_multi_exec, exec, shell_exec, system, passthru]
        eloquent:
            modelClasses: []
            modelNamespaces: []
            excludeModels: []
            observerClasses: []
            observerNamespaces: []
            databaseDateFormat: 'Y-m-d\TH:i:s.uP'
            jsonDateFormat: 'Y-m-d\TH:i:s.uP'
            trustedDateSerializers: []
            morphTypeColumns: []
            dynamicConfiguration: []
            dateCastExceptions: []
            writableProperties: []
            queryProperties: []
        postgresqlInstants:
            paths: []
            excludePaths: []
        mutableCollections:
            owners: []
            namespaces: []
            types:
                - Illuminate\Support\Collection
                - Doctrine\Common\Collections\Collection
        dto:
            classes: []
            namespaces: []
            forbiddenMethods:
                - {class: PDO, methods: ['*']}
                - {class: PDOStatement, methods: ['*']}
                - {class: Psr\Http\Client\ClientInterface, methods: [sendRequest]}
                - {class: Psr\SimpleCache\CacheInterface, methods: ['*']}
                - {class: Psr\Log\LoggerInterface, methods: ['*']}
            forbiddenFunctions:
                - file_get_contents
                - file_put_contents
                - fopen
                - fread
                - fwrite
                - unlink
                - mkdir
                - rmdir
                - rename
                - copy
                - curl_exec
                - curl_multi_exec
                - exec
                - shell_exec
                - system
                - passthru
                - mail

parametersSchema:
    noldors: structure([
        dependencies: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
        foreignKeys: structure([paths: listOf(string()), excludePaths: listOf(string())]),
        disabledTlsVerification: structure([excludePaths: listOf(string()), laravelClients: bool()]),
        fullRequestLogging: structure([
            loggerClasses: listOf(string()),
            requestClasses: listOf(string()),
            requestMethods: listOf(structure([class: string(), methods: listOf(string())])),
            excludePaths: listOf(string())
        ]),
        assertions: structure([
            forbiddenMethods: listOf(structure([class: string(), methods: listOf(string())])),
            forbiddenFunctions: listOf(string())
        ]),
        phpunitDataProviders: structure([
            forbiddenMethods: listOf(structure([class: string(), methods: listOf(string())])),
            forbiddenFunctions: listOf(string())
        ]),
        databaseBuilderMocks: structure([
            classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string()), forbiddenTypes: listOf(string())
        ]),
        ?laravel: structure([
            enums: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            enumDirectories: listOf(string()),
            lighthouseValidators: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            lighthouseResolvers: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            lighthouseSubscriptions: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            useCaseTransportTypes: listOf(string()),
            globalActorMethods: listOf(string()),
            dependencyInjection: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string()), excludedPaths: listOf(string()), helpers: listOf(string()), allLaravelHelpers: bool(), serviceLocatorTypes: listOf(string()), serviceLocatorMethods: listOf(string())]),
            validationContracts: structure([relationships: listOf(structure([class: string(), fields: listOf(string())])), inputValidators: listOf(structure([class: string(), fields: listOf(string())]))]),
            useCases: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            events: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            jobs: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            listeners: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            notifications: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            observers: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            validators: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            softDeleteModels: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            bulkLifecycleOperations: structure([classes: listOf(string()), namespaces: listOf(string()), excludedClasses: listOf(string()), excludedNamespaces: listOf(string())]),
            completedEventSuffixes: listOf(string()),
            validationExceptions: listOf(string()),
            errorBagClasses: listOf(string()),
            softDeleteTraits: listOf(string()),
            validationSideEffects: structure([
                forbiddenMethods: listOf(structure([class: string(), methods: listOf(string())])),
                forbiddenFunctions: listOf(string())
            ])
        ]),
        eloquent: structure([
            modelClasses: listOf(string()),
            modelNamespaces: listOf(string()),
            excludeModels: listOf(string()),
            observerClasses: listOf(string()),
            observerNamespaces: listOf(string()),
            databaseDateFormat: string(),
            jsonDateFormat: string(),
            trustedDateSerializers: listOf(string()),
            morphTypeColumns: listOf(string()),
            dynamicConfiguration: listOf(structure([class: string(), properties: listOf(string())])),
            dateCastExceptions: listOf(structure([class: string(), properties: listOf(string())])),
            writableProperties: listOf(structure([class: string(), properties: listOf(string())])),
            queryProperties: listOf(structure([class: string(), properties: listOf(string())]))
        ]),
        ?allowedValidationPaths: listOf(string()),
        postgresqlInstants: structure([
            paths: listOf(string()),
            excludePaths: listOf(string())
        ]),
        mutableCollections: structure([
            owners: listOf(string()),
            namespaces: listOf(string()),
            types: listOf(string())
        ]),
        dto: structure([
            classes: listOf(string()),
            namespaces: listOf(string()),
            forbiddenMethods: listOf(structure([
                class: string(),
                methods: listOf(string())
            ])),
            forbiddenFunctions: listOf(string())
        ])
    ])

services:
    noldors.persistenceTestScope:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.databaseBuilderMocks.classes%
            namespaces: %noldors.databaseBuilderMocks.namespaces%
            excludedClasses: %noldors.databaseBuilderMocks.excludedClasses%
            excludedNamespaces: %noldors.databaseBuilderMocks.excludedNamespaces%
        autowired: false
    -
        class: Noldors\PHPStan\Rules\DisabledTlsVerificationRule
        arguments:
            excludePaths: %noldors.disabledTlsVerification.excludePaths%
            laravelClients: %noldors.disabledTlsVerification.laravelClients%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\FullRequestLoggingRule
        arguments:
            loggerClasses: %noldors.fullRequestLogging.loggerClasses%
            requestClasses: %noldors.fullRequestLogging.requestClasses%
            requestMethods: %noldors.fullRequestLogging.requestMethods%
            excludePaths: %noldors.fullRequestLogging.excludePaths%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Assertions\AssertArgumentVisitor
        tags: [phpstan.parser.richParserNodeVisitor]
    -
        class: Noldors\PHPStan\Rules\NoSideEffectsInAssertRule
        arguments:
            forbiddenMethods: %noldors.assertions.forbiddenMethods%
            forbiddenFunctions: %noldors.assertions.forbiddenFunctions%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\PHPUnit\PHPUnitProviderExecutionVisitor
        tags: [phpstan.parser.richParserNodeVisitor]
    -
        class: Noldors\PHPStan\Collectors\PHPUnitDataProviderCollector
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Collectors\PHPUnitProviderEffectCollector
        arguments:
            forbiddenMethods: %noldors.phpunitDataProviders.forbiddenMethods%
            forbiddenFunctions: %noldors.phpunitDataProviders.forbiddenFunctions%
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Rules\PHPUnitDataProviderSideEffectsRule
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\NoDatabaseBuilderMocksRule
        arguments:
            tests: @noldors.persistenceTestScope
            forbiddenTypes: %noldors.databaseBuilderMocks.forbiddenTypes%
        tags: [phpstan.rules.rule]
    noldors.collectionOwners:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.mutableCollections.owners%
            namespaces: %noldors.mutableCollections.namespaces%
        autowired: false
    noldors.dtoScope:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.dto.classes%
            namespaces: %noldors.dto.namespaces%
        autowired: false
    -
        class: Noldors\PHPStan\Rules\NoReferenceParameterRule
        arguments:
            ownedPaths: %paths%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\PreservePreviousExceptionRule
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\JsonThrowOnErrorRule
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\MutableCollectionExposureRule
        arguments:
            owners: @noldors.collectionOwners
            mutableCollectionTypes: %noldors.mutableCollections.types%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\RestrictedUsage\DtoInfrastructureUsageExtension
        arguments:
            dtoScope: @noldors.dtoScope
            forbiddenMethods: %noldors.dto.forbiddenMethods%
            forbiddenFunctions: %noldors.dto.forbiddenFunctions%
        tags:
            - phpstan.restrictedMethodUsageExtension
            - phpstan.restrictedFunctionUsageExtension
