includes:
    - php.neon
    - laravel-application.neon

parameters:
    noldors:
        disabledTlsVerification:
            laravelClients: true
        fullRequestLogging:
            loggerClasses: [Illuminate\Support\Facades\Log]
            requestMethods:
                - {class: Illuminate\Http\Request, methods: [all, json]}
        assertions:
            forbiddenMethods:
                - {class: Illuminate\Database\Eloquent\Model, methods: [save, saveOrFail, saveQuietly, update, delete, deleteQuietly, forceDelete, restore, push, increment, decrement, touch]}
                - {class: Illuminate\Database\Eloquent\Builder, methods: [create, firstOrCreate, updateOrCreate, upsert, update, delete, forceDelete, restore, increment, decrement]}
                - {class: Illuminate\Database\Query\Builder, methods: [insert, insertGetId, insertOrIgnore, update, updateOrInsert, upsert, delete, truncate, increment, decrement]}
                - {class: Illuminate\Database\Eloquent\Relations\Relation, methods: [save, saveMany, create, createMany, touch]}
                - {class: Illuminate\Database\Eloquent\Relations\BelongsToMany, methods: [attach, detach, sync, syncWithoutDetaching, toggle, updateExistingPivot]}
                - {class: Illuminate\Database\ConnectionInterface, methods: [insert, update, delete, statement, unprepared, affectingStatement]}
                - {class: Illuminate\Support\Facades\DB, methods: [insert, update, delete, statement, unprepared, affectingStatement]}
                - {class: Illuminate\Contracts\Bus\Dispatcher, methods: [dispatch, dispatchSync, dispatchNow, dispatchToQueue]}
                - {class: Illuminate\Contracts\Events\Dispatcher, methods: [dispatch, until]}
                - {class: Illuminate\Contracts\Filesystem\Filesystem, methods: [put, writeStream, delete, copy, move]}
                - {class: Illuminate\Contracts\Cache\Repository, methods: [put, putMany, add, forever, increment, decrement, forget, flush]}
            forbiddenFunctions: [dispatch, dispatch_sync, event]
        phpunitDataProviders:
            forbiddenMethods:
                - {class: Illuminate\Database\Eloquent\Model, methods: [all, find, findOrFail, first, get, save, saveQuietly, delete, create]}
                - {class: Illuminate\Database\Eloquent\Factories\Factory, methods: [create, createQuietly, createOne, createOneQuietly, createMany, createManyQuietly, insert]}
                - {class: Illuminate\Database\Eloquent\Builder, methods: [get, first, firstOrFail, find, findOrFail, count, exists, pluck, value, create, firstOrCreate, createOrFirst, updateOrCreate, upsert, forceCreate, update, delete, cursor, paginate, simplePaginate, cursorPaginate]}
                - {class: Illuminate\Database\Query\Builder, methods: [get, first, count, exists, pluck, value, sum, min, max, avg, insert, insertGetId, update, updateOrInsert, upsert, delete, truncate, cursor, paginate, simplePaginate, cursorPaginate]}
                - {class: Illuminate\Database\ConnectionInterface, methods: ['*']}
                - {class: Illuminate\Support\Facades\DB, methods: ['*']}
                - {class: Illuminate\Http\Client\Factory, methods: [send, get, head, post, put, patch, delete, options]}
                - {class: Illuminate\Http\Client\PendingRequest, methods: [send, get, head, post, put, patch, delete, options]}
                - {class: Illuminate\Support\Facades\Http, methods: [send, get, head, post, put, patch, delete, options]}
                - {class: Illuminate\Contracts\Filesystem\Filesystem, methods: ['*']}
                - {class: Illuminate\Support\Facades\Storage, methods: ['*']}
                - {class: Illuminate\Foundation\Testing\Concerns\InteractsWithContainer, methods: [mock, partialMock, spy]}
                - {class: Illuminate\Contracts\Bus\Dispatcher, methods: [dispatch, dispatchSync, dispatchNow, dispatchToQueue]}
                - {class: Illuminate\Contracts\Events\Dispatcher, methods: [dispatch, until, push, flush]}
                - {class: Illuminate\Contracts\Queue\Queue, methods: [push, pushOn, later, laterOn, bulk]}
                - {class: Illuminate\Contracts\Mail\Mailer, methods: [raw, send, sendNow]}
                - {class: Illuminate\Contracts\Mail\MailQueue, methods: [queue, later]}
                - {class: Illuminate\Contracts\Notifications\Dispatcher, methods: [send, sendNow]}
            forbiddenFunctions: [dispatch, dispatch_sync, event]
        allowedValidationPaths:
            - app/GraphQL/Validators
            - app/Http/Requests
            - app/Validation
            - app/Validators
            - app/Providers
            - app/Rules
            - tests
        dto:
            forbiddenMethods:
                - {class: Illuminate\Support\Facades\DB, methods: ['*']}
                - {class: Illuminate\Database\ConnectionInterface, methods: ['*']}
                - {class: Illuminate\Database\Query\Builder, methods: ['*']}
                - {class: Illuminate\Database\Eloquent\Builder, methods: ['*']}
                - {class: Illuminate\Database\Eloquent\Model, methods: [save, saveOrFail, delete, deleteOrFail, forceDelete, refresh]}
                - {class: Illuminate\Http\Client\Factory, methods: ['*']}
                - {class: Illuminate\Http\Client\PendingRequest, methods: ['*']}
                - {class: Illuminate\Contracts\Bus\Dispatcher, methods: ['*']}
                - {class: Illuminate\Contracts\Events\Dispatcher, methods: ['*']}
                - {class: Illuminate\Contracts\Filesystem\Filesystem, methods: ['*']}
                - {class: Illuminate\Contracts\Cache\Repository, methods: ['*']}
            forbiddenFunctions:
                - dispatch
                - dispatch_sync
                - event

services:
    -
        class: Noldors\PHPStan\Eloquent\StaticModelTable
        arguments:
            dynamicConfiguration: @noldors.dynamicModelConfiguration
    -
        class: Noldors\PHPStan\Eloquent\MethodSource
        arguments:
            parser: @currentPhpVersionSimpleDirectParser
    - Noldors\PHPStan\Eloquent\ModelConstructor
    - Noldors\PHPStan\Eloquent\PivotChain
    - Noldors\PHPStan\Eloquent\PivotMethod
    - Noldors\PHPStan\Eloquent\PivotInverseCheck
    -
        class: Noldors\PHPStan\Rules\EloquentPivotRule
        tags: [phpstan.rules.rule]
    noldors.eloquentSelection:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.eloquent.modelClasses%
            namespaces: %noldors.eloquent.modelNamespaces%
        autowired: false
    noldors.eloquentExclusions:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.eloquent.excludeModels%
        autowired: false
    noldors.eloquentObservers:
        class: Noldors\PHPStan\Configuration\ClassScope
        arguments:
            classes: %noldors.eloquent.observerClasses%
            namespaces: %noldors.eloquent.observerNamespaces%
        autowired: false
    noldors.eloquentScope:
        class: Noldors\PHPStan\Eloquent\ModelScope
        arguments:
            models: @noldors.eloquentSelection
            excluded: @noldors.eloquentExclusions
            observers: @noldors.eloquentObservers
    noldors.dynamicModelConfiguration:
        class: Noldors\PHPStan\Eloquent\PropertyExceptions
        arguments: [%noldors.eloquent.dynamicConfiguration%]
        autowired: false
    noldors.dateCastExceptions:
        class: Noldors\PHPStan\Eloquent\PropertyExceptions
        arguments: [%noldors.eloquent.dateCastExceptions%]
        autowired: false
    -
        class: Noldors\PHPStan\Rules\EloquentConfigurationRule
        arguments:
            dynamicConfiguration: @noldors.dynamicModelConfiguration
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\EloquentDateFormatRule
        arguments:
            databaseDateFormat: %noldors.eloquent.databaseDateFormat%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Eloquent\DateCastCheck
        arguments:
            jsonDateFormat: %noldors.eloquent.jsonDateFormat%
            dateCastExceptions: @noldors.dateCastExceptions
    -
        class: Noldors\PHPStan\Collectors\EloquentClassCollector
        arguments:
            dynamicConfiguration: @noldors.dynamicModelConfiguration
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Collectors\EloquentDateSerializerCollector
        arguments:
            jsonDateFormat: %noldors.eloquent.jsonDateFormat%
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Collectors\EloquentRegistrationCollector
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Collectors\EloquentProviderObserverCollector
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Collectors\EloquentMorphUsageCollector
        arguments:
            morphTypeColumns: %noldors.eloquent.morphTypeColumns%
        tags: [phpstan.collector]
    -
        class: Noldors\PHPStan\Rules\EloquentRegistrationRule
        arguments:
            trustedDateSerializers: %noldors.eloquent.trustedDateSerializers%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelPostgresInstantRule
        arguments:
            paths: %noldors.postgresqlInstants.paths%
            excludePaths: %noldors.postgresqlInstants.excludePaths%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelValidationLocationRule
        arguments:
            allowedValidationPaths: %noldors.allowedValidationPaths%
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelValidationCallableRule
        arguments:
            nodeType: PHPStan\Node\FunctionCallableNode
        autowired: false
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelValidationCallableRule
        arguments:
            nodeType: PHPStan\Node\StaticMethodCallableNode
        autowired: false
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelValidationCallableRule
        arguments:
            nodeType: PHPStan\Node\MethodCallableNode
        autowired: false
        tags: [phpstan.rules.rule]
    -
        class: Noldors\PHPStan\Rules\LaravelValidationCallableRule
        arguments:
            nodeType: PHPStan\Node\InstantiationCallableNode
        autowired: false
        tags: [phpstan.rules.rule]
